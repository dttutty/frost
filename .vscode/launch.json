{
  "version": "0.2.0",
  "configurations": [

    {
      "name": "TGN",
      "type": "debugpy",
      "request": "launch",
      "module": "torch.distributed.run",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "args": [
        "--nproc_per_node=3",
        "--master_addr=127.0.0.1",
        "--master_port=29505",
        "run.py",
        "analyzer=tgn",
        "dataset=LASTFM",
        "encoder=tgn",
        "mem_box_store=base",
        "mem_updater=tgn",
        "ngh_sampler=1_hop",
        "mail_combine=last"
      ]
    },

