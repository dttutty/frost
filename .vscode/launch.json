{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FROST Debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_preset.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "envFile": "${workspaceFolder}/.env.debug",
      "args": [
        "${input:frostModelPreset}",
        "dataset=${input:frostDataset}",
        "tqdm=true",
        "compile=false",
        "batch_size=20"
      ]
    },
    {
      "name": "FROST Bench",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_preset.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "envFile": "${workspaceFolder}/.env.bench",
      "args": [
        "${input:frostModelPreset}",
        "dataset=${input:frostDataset}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "frostModelPreset",
      "type": "pickString",
      "description": "Choose the training preset",
      "default": "tgn",
      "options": [
        "tgn",
        "apan",
        "jodie",
        "dyrep",
        "tgat",
        "graph_mixer",
        "tcl",
        "dygformer"
      ]
    },
    {
      "id": "frostDataset",
      "type": "pickString",
      "description": "Choose the dataset",
      "default": "LASTFM",
      "options": [
        "LASTFM",
        "MOOC",
        "REDDIT",
        "WIKI",
        "GDELT",
        "MAG"
      ]
    }
  ]
}
