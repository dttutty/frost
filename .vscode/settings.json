{
  "git.detectSubmodules": true,
  "git.detectSubmodulesLimit": 30,
  "git.autoRepositoryDetection": true,
  "scm.alwaysShowRepositories": true,
  "scm.repositories.selectionMode": "multiple",

  "ruff.nativeServer": "auto",
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.indexing": false,
  "python.analysis.exclude": [
    "**/.*",
    "**/.git",
    "**/__pycache__",
    "**/.ruff_cache",
    "**/node_modules",
    "**/logs",
    "**/checkpoints",
    "**/wandb",
    "**/data",
    "**/outputs",
    "**/build",
    "**/dist",
    "**/.venv",
    "**/third_party"
  ],
  "python.analysis.extraPaths": [
    "./src"
  ],
  "python.autoComplete.extraPaths": [
    "./src"
  ],

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  "files.watcherExclude": {
    "**/.git/**": true,
    "**/__pycache__/**": true,
    "**/.ruff_cache/**": true,
    "**/node_modules/**": true,
    "**/logs/**": true,
    "**/checkpoints/**": true,
    "**/wandb/**": true,
    "**/data/**": true,
    "**/outputs/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/.venv/**": true,
    "**/third_party/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.venv": true,
    "**/build": true,
    "**/dist": true,
    "hydralance": true
  },

  "cmake.configureSettings": {
    "Python_EXECUTABLE": "${workspaceFolder}/.venv/bin/python",
    "nanobind_DIR": "${workspaceFolder}/.venv/lib/python3.12/site-packages/nanobind/cmake"
  },

  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python-envs.defaultPackageManager": "ms-python.python:pip",

  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": ["latexmk"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ],
      "env": {
        "PATH": "${env:PATH}"
      }
    }
  ],
  "latex-workshop.latex.clean.command": "latexmk",

  "hydralance.excludePatterns": [
    ".venv/**",
    "outputs/**",
    "third_party/**"
  ],
  "hydralance.hideHelperFolder": true,

  "workbench.editorAssociations": {
    "README.md": "vscode.markdown.preview.editor",
    "**/README.md": "vscode.markdown.preview.editor"
  }
}
