from __future__ import annotations

from typing import List

import numpy as np
from numpy.typing import ArrayLike, NDArray

__all__: list[str] = ["ParallelSampler", "TemporalGraphBlock"]

IntArray = NDArray[np.integer]
FloatArray = NDArray[np.floating]

class ParallelSampler:
    def __init__(
        self,
        indptr: ArrayLike,  # usually IntArray
        indices: ArrayLike,  # usually IntArray
        eid: ArrayLike,  # usually IntArray
        ts: ArrayLike,  # usually FloatArray
        num_thread_per_worker: int,
        num_workers: int,
        num_layers: int,
        num_neighbors: ArrayLike,  # usually IntArray or Sequence[int]
        recent: bool,
        prop_time: bool,
        num_history: int,
        window_duration: float,
    ) -> None: ...
    def sample(self, root_nodes: ArrayLike, root_ts: ArrayLike) -> None: ...
    def reset(self) -> None: ...
    def get_ret(self) -> List[TemporalGraphBlock]: ...

class TemporalGraphBlock:
    def __init__(
        self,
        row: ArrayLike,
        col: ArrayLike,
        eid: ArrayLike,
        ts: ArrayLike,
        dts: ArrayLike,
        nodes: ArrayLike,
        dim_in: int,
        dim_out: int,
    ) -> None: ...
    def row(self) -> IntArray: ...
    def col(self) -> IntArray: ...
    def eid(self) -> IntArray: ...
    def ts(self) -> FloatArray: ...
    def dts(self) -> FloatArray: ...
    def nodes(self) -> IntArray: ...
    def dim_in(self) -> int: ...
    def dim_out(self) -> int: ...
    def tot_time(self) -> float: ...
    def search_time(self) -> float: ...
    def sample_time(self) -> float: ...
    def coo_time(self) -> float: ...
    def ptr_time(self) -> float: ...
