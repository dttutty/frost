from collections.abc import Sequence
from typing import Annotated

import numpy
from numpy.typing import NDArray


class TemporalGraph:
    def __init__(self) -> None: ...

    @property
    def indptr(self) -> Annotated[NDArray[numpy.int64], dict(shape=(1), order='C', device='cpu', writable=False)]: ...

    @indptr.setter
    def indptr(self, arg: Annotated[NDArray[numpy.int64], dict(shape=(1), order='C', device='cpu', writable=False)], /) -> None: ...

    @property
    def indices(self) -> Annotated[NDArray[numpy.int64], dict(shape=(1), order='C', device='cpu', writable=False)]: ...

    @indices.setter
    def indices(self, arg: Annotated[NDArray[numpy.int64], dict(shape=(1), order='C', device='cpu', writable=False)], /) -> None: ...

    @property
    def eid(self) -> Annotated[NDArray[numpy.int64], dict(shape=(1), order='C', device='cpu', writable=False)]: ...

    @eid.setter
    def eid(self, arg: Annotated[NDArray[numpy.int64], dict(shape=(1), order='C', device='cpu', writable=False)], /) -> None: ...

    @property
    def ts(self) -> Annotated[NDArray[numpy.float32], dict(shape=(1), order='C', device='cpu', writable=False)]: ...

    @ts.setter
    def ts(self, arg: Annotated[NDArray[numpy.float32], dict(shape=(1), order='C', device='cpu', writable=False)], /) -> None: ...

class TemporalGraphBlock:
    def __init__(self) -> None: ...

    @property
    def row(self) -> NDArray[numpy.int64]: ...

    @property
    def col(self) -> NDArray[numpy.int64]: ...

    @property
    def eid(self) -> NDArray[numpy.int64]: ...

    @property
    def ts(self) -> NDArray[numpy.float32]: ...

    @property
    def dts(self) -> NDArray[numpy.float32]: ...

    @property
    def nodes(self) -> NDArray[numpy.int64]: ...

    @property
    def dim_in(self) -> int: ...

    @property
    def dim_out(self) -> int: ...

class ParallelSampler:
    def __init__(self, graph: TemporalGraph, num_thread_per_worker: int, num_workers: int, num_layers: int, num_neighbors: Sequence[int], recent: bool = False, prop_time: bool = False, num_history: int = 1, window_duration: float = 0.0) -> None: ...

    def sample(self, root_nodes: Sequence[int], root_ts: Sequence[float]) -> None: ...

    def get_ret(self) -> list[TemporalGraphBlock]: ...
